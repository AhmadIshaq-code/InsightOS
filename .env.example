# ==========================================
# InsightOS Environment Configuration
# ==========================================

# Groq Cloud API Key (Get a free key from: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override default Groq LLM model
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend API Target (Vite development / production URL)
VITE_API_URL=http://127.0.0.1:8000
